import React, { useState } from 'react';
import { DragDropContext, Droppable, Draggable } from 'react-beautiful-dnd';

const DataComparison = ({ data }) => {
  const [comparisonItems, setComparisonItems] = useState([]);
  const [selectedMetrics, setSelectedMetrics] = useState(['spending', 'frequency']);

  return (
    <div className="data-comparison">
      <h3>🔄 Interactive Data Comparison</h3>

      <div className="comparison-builder">
        <div className="available-items">
          <h4>Available Data Points</h4>
          <DragDropContext onDragEnd={(result) => {
            // Handle drag and drop
          }}>
            <Droppable droppableId="available">
              {(provided) => (
                <div {...provided.droppableProps} ref={provided.innerRef}>
                  {data.available.map((item, index) => (
                    <Draggable key={item.id} draggableId={item.id} index={index}>
                      {(provided) => (
                        <div
                          ref={provided.innerRef}
                          {...provided.draggableProps}
                          {...provided.dragHandleProps}
                          className="drag-item"
                        >
                          {item.label}
                        </div>
                      )}
                    </Draggable>
                  ))}
                  {provided.placeholder}
                </div>
              )}
            </Droppable>
          </DragDropContext>
        </div>

        <div className="comparison-area">
          <h4>Comparison View</h4>
          <div className="comparison-grid">
            {comparisonItems.map((item, index) => (
              <div key={index} className="comparison-item">
                <div className="item-header">
                  <span>{item.label}</span>
                  <button onClick={() => removeComparison(index)}>×</button>
                </div>
                <div className="item-chart">
                  <ResponsiveContainer width="100%" height={200}>
                    <LineChart data={item.data}>
                      <Line type="monotone" dataKey="value" stroke="#8884d8" />
                      <Tooltip />
                    </LineChart>
                  </ResponsiveContainer>
                </div>
                <div className="item-stats">
                  <div>Total: ${item.total.toFixed(2)}</div>
                  <div>Average: ${item.average.toFixed(2)}</div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div className="comparison-controls">
          <select onChange={(e) => setSelectedMetrics(e.target.value.split(','))}>
            <option value="spending,frequency">Spending & Frequency</option>
            <option value="category,vendor">Category & Vendor</option>
            <option value="date,amount">Date & Amount</option>
            <option value="seasonal,trend">Seasonal & Trend</option>
          </select>
          <button onClick={() => generateComparison()}>Generate Comparison</button>
        </div>
      </div>

      <div className="comparison-insights">
        <h4>📊 Comparison Insights</h4>
        <div className="insights-grid">
          {comparisonItems.map((item, index) => (
            <div key={index} className="insight-item">
              <div className="insight-label">{item.label}</div>
              <div className="insight-value">{item.insight}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
};