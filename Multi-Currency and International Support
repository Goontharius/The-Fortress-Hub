  AUD: { symbol: 'AU$', rate: 1.53, locale: 'en-AU' },
  // Add 150+ currencies
};

// Auto-detect from receipt
async function detectCurrency(text) {
  const patterns = {
    USD: /(\$|USD|US\s?Dollar)/i,
    EUR: /(€|EUR|Euro)/i,
    GBP: /(£|GBP|Pound)/i,
    // ... more patterns
  };
  
  for (const [currency, pattern] of Object.entries(patterns)) {
    if (pattern.test(text)) return currency;
  }
  return 'USD'; // default
}

// Real-time conversion
async function convertCurrency(amount, from, to, date = new Date()) {
  const rates = await getExchangeRates(date);
  return amount * (rates[to] / rates[from]);
}