// ✅ FIX: Circuit breaker pattern
const CircuitBreaker = require('opossum');

const options = {
  timeout: 30000, // 30 seconds
  errorThresholdPercentage: 50, // Open if 50% fail
  resetTimeout: 30000, // Try again after 30 seconds
  rollingCountTimeout: 10000, // 10 second window
  rollingCountBuckets: 10
};

// S3 upload with circuit breaker
const s3Breaker = new CircuitBreaker(async (params) => {
  return await config.s3.upload(params).promise();
}, options);

s3Breaker.fallback(() => {
  return { Location: process.env.FALLBACK_S3_URL || null };
});

s3Breaker.on('open', () => {
  console.error('S3 circuit breaker opened!');
  notifyOps({ service: 's3', status: 'degraded' });
});

