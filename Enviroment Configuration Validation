const config = {
  s3: new AWS.S3({
    accessKeyId: process.env.AWS_ACCESS_KEY // Might be undefined
  })
};

// ✅ FIX: Validate all config
const Joi = require('joi');

const envSchema = Joi.object({
  NODE_ENV: Joi.string().valid('development', 'production', 'test').required(),
  PORT: Joi.number().default(3000),
  DATABASE_URL: Joi.string().required(),
  REDIS_URL: Joi.string().required(),
  AWS_ACCESS_KEY: Joi.string().required(),
  AWS_SECRET_KEY: Joi.string().required(),
  GEMINI_API_KEY: Joi.string().required(),
  JWT_SECRET: Joi.string().min(32).required(),
  CORS_ORIGIN: Joi.string().optional(),
  MAX_FILE_SIZE: Joi.number().default(10 * 1024 * 1024)
}).unknown().required();

const { error, value: validatedEnv } = envSchema.validate(process.env);

if (error) {
  console.error('❌ Environment validation failed:', error.details);
  process.exit(1);
}

// Securely store config
const config = {
  env: validatedEnv.NODE_ENV,
  port: validatedEnv.PORT,
  database: validatedEnv.DATABASE_URL,
  redis: validatedEnv.REDIS_URL,
  s3: {
    accessKey: validatedEnv.AWS_ACCESS_KEY,
    secretKey: validatedEnv.AWS_SECRET_KEY
  },
  gemini: validatedEnv.GEMINI_API_KEY,
  jwtSecret: validatedEnv.JWT_SECRET,
  maxFileSize: validatedEnv.MAX_FILE_SIZE
};

// Freeze to prevent mutation
Object.freeze(config);