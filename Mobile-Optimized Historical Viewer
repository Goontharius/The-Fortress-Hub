import React, { useState } from 'react';
import { 
  View, Text, ScrollView, TouchableOpacity,
  RefreshControl, Dimensions, ActivityIndicator
} from 'react-native';
import { LineChart, PieChart } from 'react-native-chart-kit';

const HistoricalMobileView = ({ userId }) => {
  const [loading, setLoading] = useState(false);
  const [viewMode, setViewMode] = useState('timeline');
  const [selectedYear, setSelectedYear] = useState(new Date().getFullYear());
  const [data, setData] = useState(null);

  const screenWidth = Dimensions.get('window').width;

  const loadHistoricalData = async () => {
    setLoading(true);
    try {
      const response = await fetch(`/api/historical/${userId}?year=${selectedYear}`);
      const result = await response.json();
      setData(result);
    } catch (error) {
      console.error('Error loading historical data:', error);
    } finally {
      setLoading(false);
    }
  };

  if (loading) {
    return (
      <View style={{ flex: 1, justifyContent: 'center', alignItems: 'center' }}>
        <ActivityIndicator size="large" color="#8884d8" />
        <Text style={{ marginTop: 20 }}>Loading your historical data...</Text>
      </View>
    );
  }

  return (
    <ScrollView 
      style={{ flex: 1, backgroundColor: '#f5f5f5' }}
      refreshControl={
        <RefreshControl refreshing={loading} onRefresh={loadHistoricalData} />
      }
    >
      {/* Header */}
      <View style={styles.header}>
        <Text style={styles.headerTitle}>📜 Historical Archive</Text>
        <View style={styles.yearPicker}>
          <TouchableOpacity onPress={() => setSelectedYear(selectedYear - 1)}>
            <Text style={styles.yearArrow}>‹</Text>
          </TouchableOpacity>
          <Text style={styles.yearText}>{selectedYear}</Text>
          <TouchableOpacity onPress={() => setSelectedYear(selectedYear + 1)}>
            <Text style={styles.yearArrow}>›</Text>
          </TouchableOpacity>
        </View>
      </View>

      {/* Summary Cards */}
      <View style={styles.summaryGrid}>
        <View style={styles.summaryCard}>
          <Text style={styles.summaryValue}>${data?.totalSpent?.toFixed(2)}</Text>
          <Text style={styles.summaryLabel}>Total Spent</Text>
        </View>
        <View style={styles.summaryCard}>
          <Text style={styles.summaryValue}>{data?.receiptCount}</Text>
          <Text style={styles.summaryLabel}>Receipts</Text>
        </View>
        <View style={styles.summaryCard}>
          <Text style={styles.summaryValue}>{data?.vendorCount}</Text>
          <Text style={styles.summaryLabel}>Vendors</Text>
        </View>
      </View>

      {/* Trend Chart */}
      <View style={styles.chartCard}>
        <Text style={styles.chartTitle}>📈 Monthly Trend</Text>
        {data?.monthlyData && (
          <LineChart
            data={{
              labels: data.monthlyData.map(d => d.month),
              datasets: [{
                data: data.monthlyData.map(d => d.spent)
              }]
            }}
            width={screenWidth - 40}
            height={220}
            chartConfig={{
              backgroundColor: '#fff',
              backgroundGradientFrom: '#fff',
              backgroundGradientTo: '#fff',
              decimalPlaces: 0,
              color: (opacity = 1) => `rgba(136, 132, 216, ${opacity})`,
              style: {
                borderRadius: 16
              }
            }}
            bezier
            style={styles.chart}
          />
        )}
      </View>

      {/* Category Breakdown */}
      <View style={styles.chartCard}>
        <Text style={styles.chartTitle}>🏷️ Categories</Text>
        {data?.categoryData && (
          <PieChart
            data={data.categoryData.map(cat => ({
              name: cat.category,
              amount: cat.total,
              color: cat.color,
              legendFontColor: '#333',
              legendFontSize: 12
            }))}
            width={screenWidth - 40}
            height={200}
            chartConfig={{
              color: (opacity = 1) => `rgba(0, 0, 0, ${opacity})`
            }}
            accessor="amount"
            backgroundColor="transparent"
            paddingLeft="15"
            absolute
          />
        )}
      </View>

      {/* Timeline */}
      <View style={styles.timelineCard}>
        <Text style={styles.timelineTitle}>⏳ Spending Timeline</Text>
        {data?.timeline?.map((item, index) => (
          <View key={index} style={styles.timelineItem}>
            <View style={styles.timelineDot} />
            <View style={styles.timelineContent}>
              <Text style={styles.timelineDate}>{item.date}</Text>
              <Text style={styles.timelineVendor}>{item.vendor}</Text>
              <Text style={styles.timelineAmount}>${item.total.toFixed(2)}</Text>
            </View>
          </View>
        ))}
      </View>
    </ScrollView>
  );
};

