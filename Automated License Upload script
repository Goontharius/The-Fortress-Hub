#!/bin/bash
# scripts/upload-license.sh - One-click license upload

#!/bin/bash

echo "🏰 The Fortress Hub - License Uploader"
echo "====================================="

# Colors
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Select license type
echo "Select license type:"
echo "1) MIT (Open Source)"
echo "2) Apache 2.0 (Enterprise)"
echo "3) GPL 3.0 (Copyleft)"
echo "4) Commercial (Proprietary)"
echo "5) Custom"

read -p "Enter choice (1-5): " choice

case $choice in
  1)
    LICENSE_TYPE="MIT"
    LICENSE_URL="https://raw.githubusercontent.com/your-username/the-fortress-hub/main/docs/licenses/MIT.md"
    ;;
  2)
    LICENSE_TYPE="Apache-2.0"
    LICENSE_URL="https://raw.githubusercontent.com/your-username/the-fortress-hub/main/docs/licenses/Apache-2.0.md"
    ;;
  3)
    LICENSE_TYPE="GPL-3.0"
    LICENSE_URL="https://raw.githubusercontent.com/your-username/the-fortress-hub/main/docs/licenses/GPL-3.0.md"
    ;;
  4)
    LICENSE_TYPE="Commercial"
    LICENSE_URL="https://raw.githubusercontent.com/your-username/the-fortress-hub/main/docs/licenses/commercial.md"
    ;;
  5)
    echo "Enter custom license file path:"
    read -r CUSTOM_PATH
    cp "$CUSTOM_PATH" LICENSE
    echo "✅ Custom license copied!"
    exit 0
    ;;
  *)
    echo -e "${RED}Invalid choice${NC}"
    exit 1
    ;;
esac

# Download license
echo -e "${YELLOW}Downloading ${LICENSE_TYPE} license...${NC}"
curl -L "$LICENSE_URL" -o LICENSE

if [ $? -eq 0 ]; then
  echo -e "${GREEN}✅ License downloaded successfully${NC}"
else
  echo -e "${RED}❌ Failed to download license${NC}"
  exit 1
fi

# Update package.json
echo -e "${YELLOW}Updating package.json...${NC}"
if [ -f package.json ]; then
  # Update license field
  sed -i.bak "s/\"license\":.*/\"license\": \"${LICENSE_TYPE}\",/" package.json
  rm package.json.bak
  echo -e "${GREEN}✅ package.json updated${NC}"
fi

# Add to git
echo -e "${YELLOW}Adding to git...${NC}"
git add LICENSE package.json
git commit -m "Add ${LICENSE_TYPE} license"
git push origin main

echo -e "${GREEN}✅ License uploaded successfully!${NC}"
echo "📋 View at: https://github.com/your-username/the-fortress-hub/blob/main/LICENSE"