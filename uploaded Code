// Upload Route
app.post('/api/upload', upload.single('receipt'), async (req, res) => {
  try {
    const { userId, category = 'uncategorized', notes = '' } = req.body;
    const file = req.file;
    
    if (!file) {
      return res.status(400).json({ error: 'No file uploaded' });
    }
    
    if (!userId) {
      return res.status(400).json({ error: 'userId is required' });
    }
    
    // Compress and optimize image
    const sharp = require('sharp');
    const compressed = await sharp(file.buffer)
      .jpeg({ 
        quality: parseInt(process.env.IMAGE_QUALITY) || 80,
        progressive: true
      })
      .resize(parseInt(process.env.MAX_IMAGE_WIDTH) || 1200, null, { 
        fit: 'inside',
        withoutEnlargement: true
      })
      .toBuffer();
    
    // Generate unique filename
    const timestamp = Date.now();
    const uuid = require('uuid').v4();
    const filename = `${userId}/${uuid}-${timestamp}.jpg`;
    
    // Upload to S3 with metadata
    const s3Result = await config.s3.upload({
      Bucket: config.bucket,
      Key: filename,
      Body: compressed,
      ContentType: 'image/jpeg',
      ContentDisposition: 'inline',
      CacheControl: 'max-age=31536000',
      Metadata: {
        userId,
        uploadedAt: new Date().toISOString(),
        category,
        notes: notes || '',
        originalName: file.originalname || '',
        fileSize: String(file.size)
      }
    }).promise();
    
    // Queue for OCR processing
    const job = await receiptQueue.add('process-receipt', {
      imageUrl: s3Result.Location,
      s3Key: filename,
      userId,
      category,
      notes,
      uploadedAt: new Date().toISOString(),
      metadata: {
        fileSize: file.size,
        mimeType: file.mimetype,
        originalName: file.originalname
      }
    }, {
      priority: 1,
      delay: 0
    });
    
    // Store job reference in Redis for status tracking
    await config.redis.setex(
      `job:${job.id}`,
      3600,
      JSON.stringify({
        status: 'queued',
        userId,
        s3Key: filename,
        createdAt: new Date().toISOString()
      })
    );
    
    res.json({
      success: true,
      jobId: job.id,
      imageUrl: s3Result.Location,
      s3Key: filename,
      message: 'Receipt uploaded and queued for processing',
      metadata: {
        size: compressed.length,
        uploadedAt: new Date().toISOString()
      }
    });
  } catch (error) {
    console.error('Upload error:', error);
    res.status(500).json({ 
      error: error.message,
      code: 'UPLOAD_ERROR'
    });
  }
});

