CREATE INDEX idx_activity_user ON activity_log(user_id, created_at DESC);
CREATE INDEX idx_activity_action ON activity_log(action);

-- =============================================
-- TRIGGERS
-- =============================================

-- Update updated_at timestamp
CREATE OR REPLACE FUNCTION update_updated_at()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = NOW();
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER update_users_updated_at
    BEFORE UPDATE ON users
    FOR EACH ROW EXECUTE FUNCTION update_updated_at();

CREATE TRIGGER update_receipts_updated_at
    BEFORE UPDATE ON receipts
    FOR EACH ROW EXECUTE FUNCTION update_updated_at();

CREATE TRIGGER update_analytics_daily_updated_at
    BEFORE UPDATE ON analytics_daily
    FOR EACH ROW EXECUTE FUNCTION update_updated_at();

-- =============================================
-- VIEWS
-- =============================================

-- Monthly spending view
CREATE VIEW v_monthly_spending AS
SELECT 
    user_id,
    date_trunc('month', date)::date AS month,
    COUNT(*) AS receipt_count,
    SUM(total) AS total_spent,
    SUM(tax) AS total_tax,
    AVG(total) AS avg_receipt,
    jsonb_agg(DISTINCT category) AS categories,
    jsonb_agg(DISTINCT vendor) AS vendors
FROM receipts
WHERE status = 'processed'
GROUP BY user_id, date_trunc('month', date);

-- Top categories view
CREATE VIEW v_top_categories AS
SELECT 
    user_id,
    category,
    COUNT(*) AS count,
    SUM(total) AS total,
    AVG(total) AS average,
    SUM(tax) AS tax_total,
    RANK() OVER (PARTITION BY user_id ORDER BY SUM(total) DESC) AS rank
FROM receipts
WHERE status = 'processed'
GROUP BY user_id, category;

-- =============================================
-- FUNCTIONS
-- =============================================

-- Generate monthly analytics
CREATE OR REPLACE FUNCTION generate_monthly_analytics(user_uuid UUID, target_date DATE DEFAULT NULL)
RETURNS VOID AS $$
DECLARE
    target_month DATE;
BEGIN
    target_month := COALESCE(target_date, CURRENT_DATE);
    
    INSERT INTO analytics_monthly (user_id, year, month, total_spent, tax_total, receipt_count, top_categories, top_vendors)
    SELECT 
        user_id,
        EXTRACT(YEAR FROM target_month)::INTEGER,
        EXTRACT(MONTH FROM target_month)::INTEGER,
        COALESCE(SUM(total), 0),
        COALESCE(SUM(tax), 0),
        COUNT(*),
        (
            SELECT jsonb_agg(jsonb_build_object('category', category, 'total', total))
            FROM (
                SELECT category, SUM(total) AS total
                FROM receipts
                WHERE user_id = user_uuid
                    AND date >= date_trunc('month', target_month)
                    AND date < date_trunc('month', target_month) + INTERVAL '1 month'
                    AND status = 'processed'
                GROUP BY category
                ORDER BY total DESC
                LIMIT 5
            ) sub
        ),
        (
            SELECT jsonb_agg(jsonb_build_object('vendor', vendor, 'total', total))
            FROM (
                SELECT vendor, SUM(total) AS total
                FROM receipts
                WHERE user_id = user_uuid
                    AND date >= date_trunc('month', target_month)
                    AND date < date_trunc('month', target_month) + INTERVAL '1 month'
                    AND status = 'processed'
                    AND vendor IS NOT NULL
                GROUP BY vendor
                ORDER BY total DESC
                LIMIT 5
            ) sub
        )
    FROM receipts
    WHERE user_id = user_uuid
        AND date >= date_trunc('month', target_month)
        AND date < date_trunc('month', target_month) + INTERVAL '1 month'
        AND status = 'processed'
    GROUP BY user_id
    ON CONFLICT (user_id, year, month) 
    DO UPDATE SET 
        total_spent = EXCLUDED.total_spent,
        tax_total = EXCLUDED.tax_total,
        receipt_count = EXCLUDED.receipt_count,
        top_categories = EXCLUDED.top_categories,
        top_vendors = EXCLUDED.top_vendors,
        updated_at = NOW();
END;
$$ LANGUAGE plpgsql;

