app.get('/api/analytics/:userId', async (req, res) => {
  try {
    const { userId } = req.params;
    const { period = '30d', category = null } = req.query;
    
    // Get date range
    const endDate = new Date();
    const days = parseInt(period) || 30;
    const startDate = new Date();
    startDate.setDate(endDate.getDate() - days);
    
    // Build query
    let query = `
      WITH date_series AS (
        SELECT generate_series(
          $1::date,
          $2::date,
          '1 day'::interval
        )::date AS date
      ),
      receipts_data AS (
        SELECT 
          date,
          COUNT(*) AS receipt_count,
          SUM(total) AS total_spent,
          SUM(tax) AS tax_total,
          jsonb_agg(category) AS categories,
          jsonb_agg(items) AS all_items
        FROM receipts
        WHERE user_id = $3
          AND date BETWEEN $1 AND $2
    `;
    
    const params = [startDate, endDate, userId];
    let paramIndex = 4;
    
    if (category) {
      query += ` AND category = $${paramIndex}`;
      params.push(category);
      paramIndex++;
    }
    
    query += `
        GROUP BY date
      )
      SELECT 
        ds.date,
        COALESCE(rd.receipt_count, 0) AS receipt_count,
        COALESCE(rd.total_spent, 0) AS total_spent,
        COALESCE(rd.tax_total, 0) AS tax_total,
        COALESCE(rd.categories, '[]'::jsonb) AS categories,
        COALESCE(rd.all_items, '[]'::jsonb) AS items,
        SUM(COALESCE(rd.total_spent, 0)) OVER (ORDER BY ds.date) AS cumulative_spend,
        AVG(COALESCE(rd.total_spent, 0)) OVER (ORDER BY ds.date ROWS BETWEEN 6 PRECEDING AND CURRENT ROW) AS moving_avg_7d
      FROM date_series ds
      LEFT JOIN receipts_data rd ON ds.date = rd.date
      ORDER BY ds.date DESC
    `;
    
    const result = await config.pgPool.query(query, params);
    
    // Compute insights
    const rows = result.rows;
    const totals = rows.map(r => parseFloat(r.total_spent));
    const avgDaily = totals.reduce((a, b) => a + b, 0) / totals.length || 0;
    const maxDaily = Math.max(...totals) || 0;
    const totalPeriod = totals.reduce((a, b) => a + b, 0);
    
    // Trend analysis
    const recentAvg = totals.slice(0, 7).reduce((a, b) => a + b, 0) / 7 || 0;
    const previousAvg = totals.slice(7, 14).reduce((a, b) => a + b, 0) / 7 || 0;
    const trend = recentAvg > previousAvg ? 'up' : recentAvg < previousAvg ? 'down' : 'stable';
    const percentChange = previousAvg ? ((recentAvg - previousAvg) / previousAvg * 100).toFixed(1) : 0;
    
    // Category breakdown
    const categoryQuery = `
      SELECT 
        category,
        COUNT(*) AS count,
        SUM(total) AS total,
        AVG(total) AS avg_total,
        SUM(tax) AS total_tax
      FROM receipts
      WHERE user_id = $1
        AND date BETWEEN $2 AND $3
      GROUP BY category
      ORDER BY total DESC
    `;
    
    const categoryResult = await config.pgPool.query(categoryQuery, [userId, startDate, endDate]);
    
    res.json({
      period,
      summary: {
        totalSpent: totalPeriod.toFixed(2),
        averageDaily: avgDaily.toFixed(2),
        maxDaily: maxDaily.toFixed(2),
        receiptCount: rows.reduce((sum, r) => sum + r.receipt_count, 0),
        taxTotal: rows.reduce((sum, r) => sum + parseFloat(r.tax_total || 0), 0).toFixed(2),
        trend,
        percentChange,
        daysTracked: rows.length
      },
      data: rows,
      categories: categoryResult.rows,
      insights: {
        topCategory: categoryResult.rows[0]?.category || null,
        topSpender: categoryResult.rows[0]?.total || 0,
        averageReceipt: totalPeriod / (rows.reduce((sum, r) => sum + r.receipt_count, 0) || 1)
      },
      timestamp: new Date().toISOString()
    });
  } catch (error) {
    console.error('Analytics error:', error);
    res.status(500).json({ error: error.message });
  }
});

