-- =============================================
-- AUDIT TRIGGERS
-- =============================================

CREATE OR REPLACE FUNCTION log_receipt_change()
RETURNS TRIGGER AS $$
BEGIN
    IF TG_OP = 'INSERT' THEN
        INSERT INTO activity_log (user_id, action, entity_type, entity_id, details)
        VALUES (NEW.user_id, 'receipt_created', 'receipt', NEW.id::TEXT, 
            jsonb_build_object('vendor', NEW.vendor, 'total', NEW.total, 's3_key', NEW.s3_key));
    ELSIF TG_OP = 'UPDATE' THEN
        INSERT INTO activity_log (user_id, action, entity_type, entity_id, details)
        VALUES (NEW.user_id, 'receipt_updated', 'receipt', NEW.id::TEXT,
            jsonb_build_object('changes', jsonb_build_object(
                'old', row_to_json(OLD),
                'new', row_to_json(NEW)
            )));
    END IF;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER log_receipt_changes
    AFTER INSERT OR UPDATE ON receipts
    FOR EACH ROW EXECUTE FUNCTION log_receipt_change();
