const categoryKeywords = {
  'hardware': ['home depot', 'lowes', 'ace hardware', 'menards', 'hardware', 'lumber'],
  'tools': ['dewalt', 'makita', 'milwaukee', 'harbor freight', 'tools', 'drill', 'saw'],
  'electrical': ['wire', 'conduit', 'breaker', 'panel', 'switch', 'electrical', 'cable'],
  'plumbing': ['pipe', 'fitting', 'valve', 'faucet', 'pvc', 'plumbing', 'water heater'],
  'paint': ['paint', 'primer', 'brush', 'roller', 'spray', 'caulk'],
  'lumber': ['plywood', '2x4', 'stud', 'beam', 'lumber', 'wood', 'timber'],
  'materials': ['cement', 'concrete', 'drywall', 'insulation', 'roofing'],
  'supplies': ['nails', 'screws', 'glue', 'tape', 'sandpaper', 'fasteners'],
  'equipment': ['rental', 'scaffold', 'ladder', 'compressor', 'generator'],
  'transportation': ['gas', 'fuel', 'toll', 'parking', 'vehicle'],
  'office': ['printing', 'paper', 'ink', 'shipping', 'office']
};

function categorizeReceipt(vendor, items, total) {
  const text = (vendor + ' ' + JSON.stringify(items)).toLowerCase();
  
  // Weighted scoring
  let scores = {};
  
  for (const [category, keywords] of Object.entries(categoryKeywords)) {
    let score = 0;
    for (const keyword of keywords) {
      if (text.includes(keyword)) {
        // Weight by frequency
        const count = (text.match(new RegExp(keyword, 'g')) || []).length;
        score += count * 2;
        
        // Bonus for exact matches
        if (text.includes(' ' + keyword + ' ')) {
          score += 3;
        }
      }
    }
    if (score > 0) {
      scores[category] = score;
    }
  }
  
  // Find top category
  if (Object.keys(scores).length === 0) {
    // Default based on total amount
    if (total > 500) return 'large_purchase';
    if (total > 200) return 'medium_purchase';
    return 'supplies';
  }
  
  return Object.keys(scores).reduce((a, b) => scores[a] > scores[b] ? a : b);
}

