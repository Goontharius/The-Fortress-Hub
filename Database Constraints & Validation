-- Data validation triggers
CREATE OR REPLACE FUNCTION validate_receipt_data()
RETURNS TRIGGER AS $$
BEGIN
    -- Check total matches items sum
    IF NEW.items IS NOT NULL AND NEW.items != '[]' THEN
        DECLARE
            item_sum DECIMAL(15,2);
        BEGIN
            SELECT COALESCE(SUM((item->>'price')::DECIMAL * (item->>'quantity')::INTEGER), 0)
            INTO item_sum
            FROM jsonb_array_elements(NEW.items) AS item;
            
            IF item_sum != NEW.total AND NEW.total IS NOT NULL THEN
                -- Log warning but don't block
                RAISE WARNING 'Total mismatch: items sum % vs total %', item_sum, NEW.total;
            END IF;
        END;
    END IF;
    
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER validate_receipt_trigger
    BEFORE INSERT OR UPDATE ON receipts
    FOR EACH ROW EXECUTE FUNCTION validate_receipt_data();