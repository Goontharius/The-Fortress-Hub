{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@backend/*": ["src/backend/src/*"],
      "@frontend/*": ["src/frontend/src/*"],
      "@mobile/*": ["src/mobile/src/*"],
      "@desktop/*": ["src/desktop/src/*"]
    }
  }
}
