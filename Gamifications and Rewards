  // Leaderboard
  async getLeaderboard() {
    return await db.query(`
      SELECT 
        user_id,
        SUM(points) as total_points,
        COUNT(DISTINCT badge_id) as badge_count,
        RANK() OVER (ORDER BY SUM(points) DESC) as rank
      FROM gamification
      GROUP BY user_id
      ORDER BY rank
      LIMIT 100
    `);
  }
  
